# Firebase 本機快取
.firebase/
# 部署產物（index.html 的複本，deploy 時自動產生）
/public/
# b2lab/public 是原始碼不是產物，必須進版控
!b2lab/public/
# 備份與本機工作檔
index.backup-*.html
.sync-log.txt
.last-sync-marker
# 本機/編輯器
.claude/settings.local.json
node_modules/
**/desktop.ini

# ⚠️ 密鑰：絕對不能進版控（外洩等於整個 Firebase 專案被接管）
# Firebase 服務帳號金鑰，例：english-b2-lab-firebase-adminsdk-fbsvc-*.json
*-firebase-adminsdk-*.json
*serviceAccount*.json
*service-account*.json
.env
.env.*
!.env.example
*.pem
*.key
*.p12
