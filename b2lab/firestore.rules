rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 學習進度：只允許 Anita / Tom 兩份文件
    match /b2lab_progress/{who} {
      allow read, write: if who == 'anita' || who == 'tom';
    }
    // 自己加入的 YouTube 影片與逐字稿：文件 id 必須是 11 字元的 YouTube 影片 ID，
    // 兩位學習者共用同一個影片庫（跟課堂筆記站的做法一致）
    match /b2lab_videos/{vid} {
      allow read: if true;
      allow write: if vid.size() == 11;
    }
    // 內建聽力課的補充逐字稿（學習者自己貼上的，兩人共用）
    // 文件 id ＝課程 id（例 vlog01、dl20260814a2）
    match /b2lab_lesson_subs/{lesson} {
      allow read: if true;
      allow write: if lesson.size() >= 3 && lesson.size() <= 24;
    }
  }
}
