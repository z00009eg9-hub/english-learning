rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 只允許存取 Anita / Tom 兩個學習者的進度文件
    match /progress/{who} {
      allow read, write: if who == 'anita' || who == 'tom';
    }
    // 共用影片庫：所有裝置／學習者同步同一份
    match /shared/videos {
      allow read, write: if true;
    }
  }
}
